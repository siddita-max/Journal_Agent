# ─── Google Drive API ───────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/photo-agent-494106-23b977507358.json
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# ─── Database ───────────────────────────────────────────────────────
POSTGRES_USER=photo_agent
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=photo_agent_db
DATABASE_URL=postgresql+asyncpg://photo_agent:change_me_in_production@postgres:5432/photo_agent_db

# ─── Redis / Celery ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=4

# ─── MinIO / Object Storage ─────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_APPROVED=approved-images
MINIO_BUCKET_REJECTED=rejected-images
MINIO_SECURE=false

# ─── AI Models ──────────────────────────────────────────────────────
CLIP_MODEL_NAME=ViT-L/14@336px
YOLO_MODEL_PATH=/app/models/yolov8s.pt
YOLO_AUGMENT=false
DEVICE=auto   # auto | cpu | cuda

# ─── Scoring Thresholds ─────────────────────────────────────────────
SCORE_APPROVED_THRESHOLD=0.75
SCORE_REVIEW_THRESHOLD=0.60

# ─── Preprocessing Limits ───────────────────────────────────────────
MIN_RESOLUTION_WIDTH=400
MIN_RESOLUTION_HEIGHT=400
MIN_BLUR_VARIANCE=100.0
MIN_BRIGHTNESS=30
MAX_BRIGHTNESS=240
MIN_ASPECT_RATIO=0.5
MAX_ASPECT_RATIO=3.0

# ─── Security ───────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_secret_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
